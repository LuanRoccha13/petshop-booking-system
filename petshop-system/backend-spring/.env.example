# Copie este arquivo para .env e preencha com valores locais.
# NUNCA commite o arquivo .env real.

# Gere um valor forte, por exemplo com:
# openssl rand -base64 48
JWT_SECRET=

# Opcional — já têm defaults não sensíveis em application.properties, mas podem ser sobrescritos:
# DB_HOST=localhost
# DB_NAME=petshop
# DB_USERNAME=petshop
# DB_PASSWORD=petshop
# JWT_EXPIRATION_MS=86400000
# JWT_REFRESH_EXPIRATION_MS=2592000000
# APP_UPLOAD_DIR=uploads
